# Default path: Tailscale Funnel. server/tunnel/install_tailscale_funnel.sh
# fills this in; apps use the stable https://<machine>.<tailnet>.ts.net address
# without installing Tailscale on the phone.
TUNNEL_PROVIDER=tailscale_funnel
VOCAB_SYNC_PUBLIC_URL=https://your-mac-mini.your-tailnet.ts.net

# Legacy (transition only): Cloudflare Worker + quick tunnel. Keep these while
# installed apps still use the workers.dev address.
# CF_WORKER_PUBLIC_URL=https://vocab-sync.your-workers-subdomain.workers.dev
# CF_WORKER_ADMIN_TOKEN=replace-with-worker-admin-token
