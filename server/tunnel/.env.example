# Default path: Cloudflare only, no purchased domain.
# Android/MacBook use the stable workers.dev URL. Mac mini keeps a free
# Cloudflare quick tunnel alive and publishes its current trycloudflare URL
# to the Worker admin endpoint.
TUNNEL_PROVIDER=cloudflare_quick_worker
CF_WORKER_PUBLIC_URL=https://vocab-sync.your-workers-subdomain.workers.dev
CF_WORKER_ADMIN_TOKEN=replace-with-worker-admin-token
