<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vocabreminder.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__SERVER_DIR__" &amp;&amp; "__NPM_BIN__" start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__SERVER_DIR__</string>
  <key>StandardOutPath</key>
  <string>__SERVER_DIR__/logs/sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__SERVER_DIR__/logs/sync.err.log</string>
</dict>
</plist>
