{
  "name": "vocab-reminder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server:start": "npm --prefix server start",
    "server:test": "npm --prefix server test",
    "sync:local-smoke": "node tools/local_sync_smoke.mjs",
    "sync:android-smoke": "node tools/android_cloud_sync_smoke.mjs",
    "sync:android-release-ui-smoke": "bash tools/android_release_ui_smoke.sh",
    "sync:mac-smoke": "node tools/mac_cloud_sync_smoke.mjs",
    "sync:tunnel-smoke": "node tools/cloudflared_quick_tunnel_smoke.mjs",
    "sync:smoke": "bash tools/sync_smoke.sh",
    "sync:release": "bash tools/build_sync_release.sh",
    "sync:check-endpoint": "bash tools/check_sync_endpoint.sh",
    "sync:check-artifacts": "bash tools/check_sync_release_artifacts.sh",
    "sync:doctor": "bash tools/sync_doctor.sh",
    "sync:repair": "bash tools/repair_sync_runtime.sh",
    "qc:all": "bash tools/qc_all.sh",
    "mac:install-capture-service": "bash tools/install_mac_capture_service.sh",
    "sync:setup-cloudflare-worker": "bash tools/setup_cloudflare_worker.sh",
    "sync:setup-mac-mini": "bash tools/setup_mac_mini_sync.sh",
    "sync:preflight": "bash tools/sync_release_preflight.sh",
    "recommendations:build": "node shared/recommendations/scripts/build_catalog.mjs",
    "recommendations:pool": "node shared/recommendations/scripts/build_candidate_pool.mjs",
    "recommendations:queue": "node shared/recommendations/scripts/build_fill_queue.mjs",
    "recommendations:enrich": "node shared/recommendations/scripts/enrich_fill_queue.mjs",
    "recommendations:enrich:sample": "RECOMMENDATION_ENRICH_LIMIT=3 RECOMMENDATION_ENRICH_REQUIRE_COMPLETE=true RECOMMENDATION_ENRICH_OUTPUT=shared/recommendations/recommendation_enriched_candidates.sample.json RECOMMENDATION_DICTIONARY_FIXTURE_JSON=shared/recommendations/fixtures/fill_dictionary_fixture.json RECOMMENDATION_TRANSLATION_FIXTURE_JSON=shared/recommendations/fixtures/fill_translation_fixture.json node shared/recommendations/scripts/enrich_fill_queue.mjs",
    "recommendations:all": "npm run recommendations:pool && npm run recommendations:queue && npm run recommendations:enrich:sample && npm run recommendations:build"
  },
  "devDependencies": {
    "subtlex-word-frequencies": "2.0.0"
  }
}
