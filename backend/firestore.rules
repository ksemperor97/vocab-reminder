rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonBlankString(value) {
      return value is string && value.trim().size() > 0;
    }

    function isRecommendationFeedback() {
      return isNonBlankString(request.resource.data.card_id) &&
        isNonBlankString(request.resource.data.lemma) &&
        request.resource.data.action in ["started", "known", "dismissed"];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /cards/{cardId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /contexts/{contextId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /definition_candidates/{candidateId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /review_events/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /recommendation_feedback/{feedbackId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isRecommendationFeedback();
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /settings/main {
        allow read, create, update, delete: if isOwner(uid);
      }
    }
  }
}
