{
  "name": "vocab-reminder-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/sync-payload.test.mjs",
    "test:rules": "node --test test/firestore-rules.test.mjs",
    "emulators:rules": "firebase emulators:exec --only firestore \"npm run test:rules\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.22.4",
    "typescript": "^5.7.0"
  }
}
