      "lemma": "look",
      "candidates": ["looking"]
    }
  },
  {
    "name": "short phrase with clipped trailing token uses content word",
    "raw": "looking fo",
    "then": {
      "needs_word_selection": false,
      "display_word": "looking",
      "lemma": "look",
      "candidates": ["looking"]
    }
  },
